<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="aquatemp"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<bridge-type id="bridge">
		<label>AquaTemp Connect Bridge</label>
		<description>The bridge to communicate with the AquaTemp API</description>
		<channels>
			<channel id="count-api-calls" typeId="number">
				<label>Count API Calls</label>
			</channel>
			<channel id="run-query-once" typeId="run-query-once">
				<label>Run Device Query</label>
			</channel>
		</channels>
		<properties>
			<property name="thingTypeVersion">4</property>
		</properties>
		<config-description>
			<parameter name="user" type="text" required="true">
				<label>E-Mail address</label>
				<description>The E-Mail address for which the application key has been issued</description>
				<context>email</context>
			</parameter>
			<parameter name="password" type="text" required="true">
				<label>Password</label>
				<description>The password for the given E-Mail address</description>
				<context>password</context>
			</parameter>
			<parameter name="cloudApi" type="text" required="false">
				<label>Cloud API</label>
				<description>The cloud service used by the AquaTemp account</description>
				<default>linkedGo</default>
				<options>
					<option value="linkedGo">LinkedGo (legacy)</option>
					<option value="goHeating">Go Heating (AquaTemp app 2.2.1 or newer)</option>
				</options>
				<limitToOptions>true</limitToOptions>
			</parameter>
			<parameter name="productIds" type="text" required="false">
				<label>Go Heating Product IDs</label>
				<description>Comma-separated product IDs sent when loading the Go Heating device list</description>
				<default>1132174963097280512,1777261505886740482</default>
				<advanced>true</advanced>
			</parameter>
			<parameter name="disablePolling" type="boolean" required="false">
				<label>Disable polling</label>
				<description>Deactivates the polling to carry out the manual poll using an item</description>
				<default>false</default>
				<advanced>true</advanced>
			</parameter>
			<parameter name="apiCallLimit" type="integer" required="false">
				<label>API call limit</label>
				<description>The limit how often call the API. For calculating the time how often the data is queried in
					seconds</description>
				<default>1450</default>
				<advanced>true</advanced>
			</parameter>
			<parameter name="bufferApiCommands" type="integer" required="false">
				<label>Buffer for API commands</label>
				<description>The buffer for commands. For calculating the time how often the data is queried in seconds</description>
				<default>450</default>
				<advanced>true</advanced>
			</parameter>
			<parameter name="pollingInterval" type="integer" required="false" unit="s">
				<label>Polling Interval</label>
				<default>0</default>
				<description>How often the heating should be queried in seconds (If it's set to 0, then the interval will
					be
					calculated by the binding)</description>
				<advanced>true</advanced>
			</parameter>
		</config-description>
	</bridge-type>

	<!-- AquaTemp Device Thing Type -->
	<thing-type id="device">
		<supported-bridge-type-refs>
			<bridge-type-ref id="bridge"/>
		</supported-bridge-type-refs>
		<label>AquaTemp Device</label>
		<channels>
			<channel id="power-state" typeId="boolean">
				<label>Power Switch</label>
			</channel>
			<channel id="inlet-temperature" typeId="temperature">
				<label>Inlet temperature</label>
			</channel>
			<channel id="outlet-temperature" typeId="temperature">
				<label>Outlet temperature</label>
			</channel>
			<channel id="ambient-temperature" typeId="temperature">
				<label>Ambient temperature</label>
			</channel>
			<channel id="target-temperature" typeId="set-temperature">
				<label>Target temperature</label>
			</channel>
			<channel id="silent-mode" typeId="boolean">
				<label>Silent Mode</label>
			</channel>
			<channel id="mode" typeId="mode">
				<label>Mode</label>
			</channel>
			<channel id="consumption" typeId="power">
				<label>Consumption</label>
			</channel>
			<channel id="actual-power" typeId="power">
				<label>Actual Power</label>
			</channel>
			<channel id="electricity-consumption-per-hour" typeId="energy">
				<label>Electricity Consumption per Hour</label>
			</channel>
			<channel id="compressor-output-frequency" typeId="frequency">
				<label>Compressor Output Frequency</label>
			</channel>
			<channel id="compressor-current" typeId="electric-current">
				<label>Compressor Current</label>
			</channel>
			<channel id="operating-state" typeId="string-read-only">
				<label>Operating State</label>
			</channel>
			<channel id="flow-switch" typeId="boolean-read-only">
				<label>Flow Switch</label>
			</channel>
			<channel id="error-message" typeId="string-read-only">
				<label>Error message</label>
			</channel>
			<channel id="error-is-active" typeId="boolean-read-only">
				<label>Error is active</label>
			</channel>
		</channels>
		<properties>
			<property name="thingTypeVersion">3</property>
		</properties>
		<representation-property>deviceId</representation-property>
		<config-description>
			<parameter name="deviceId" type="text" required="true">
				<label>Device Id</label>
				<default>0</default>
			</parameter>
		</config-description>
	</thing-type>

	<!-- Channel Types -->
	<channel-type id="temperature">
		<item-type>Number:Temperature</item-type>
		<label>Temperature</label>
		<category>Temperature</category>
		<tags>
			<tag>Measurement</tag>
			<tag>Temperature</tag>
		</tags>
		<state pattern="%.1f %unit%" readOnly="true"/>
	</channel-type>

	<channel-type id="set-temperature">
		<item-type>Number:Temperature</item-type>
		<label>Set temperature</label>
		<category>Temperature</category>
		<tags>
			<tag>Setpoint</tag>
			<tag>Temperature</tag>
		</tags>
		<state min="6" max="35" step="0.5" pattern="%.1f %unit%" readOnly="false"/>
	</channel-type>

	<channel-type id="power">
		<item-type>Number:Power</item-type>
		<label>Power</label>
		<category>Energy</category>
		<tags>
			<tag>Measurement</tag>
			<tag>Power</tag>
		</tags>
		<state pattern="%d %unit%" readOnly="true"/>
	</channel-type>

	<channel-type id="energy">
		<item-type unitHint="kWh">Number:Energy</item-type>
		<label>Energy</label>
		<category>Energy</category>
		<tags>
			<tag>Measurement</tag>
			<tag>Energy</tag>
		</tags>
		<state pattern="%.2f %unit%" readOnly="true"/>
	</channel-type>

	<channel-type id="frequency">
		<item-type unitHint="Hz">Number:Frequency</item-type>
		<label>Frequency</label>
		<category>Energy</category>
		<tags>
			<tag>Measurement</tag>
		</tags>
		<state pattern="%.1f %unit%" readOnly="true"/>
	</channel-type>

	<channel-type id="electric-current">
		<item-type unitHint="A">Number:ElectricCurrent</item-type>
		<label>Electric Current</label>
		<category>Energy</category>
		<tags>
			<tag>Measurement</tag>
		</tags>
		<state pattern="%.1f %unit%" readOnly="true"/>
	</channel-type>

	<channel-type id="number">
		<item-type>Number</item-type>
		<label>Number</label>
		<category>Number</category>
		<state pattern="%d %unit%" readOnly="false"/>
	</channel-type>

	<channel-type id="mode">
		<item-type>String</item-type>
		<label>Mode</label>
		<category>Heating</category>
		<tags>
			<tag>Control</tag>
			<tag>Mode</tag>
		</tags>
		<state readOnly="false">
			<options>
				<option value="0">Cooling</option>
				<option value="1">Heating</option>
				<option value="2">Auto</option>
			</options>
		</state>
	</channel-type>

	<channel-type id="string-read-only">
		<item-type>String</item-type>
		<label>String</label>
		<category>Text</category>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="boolean">
		<item-type>Switch</item-type>
		<label>Switch</label>
		<category>Switch</category>
	</channel-type>

	<channel-type id="boolean-read-only">
		<item-type>Switch</item-type>
		<label>Switch</label>
		<category>Switch</category>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="run-query-once" advanced="true">
		<item-type>Switch</item-type>
		<label>Run device query once</label>
		<category>Switch</category>
	</channel-type>

	<channel-type id="error-is-active">
		<item-type>Switch</item-type>
		<label>Error is active</label>
		<category>Error</category>
		<tags>
			<tag>Status</tag>
			<tag>Info</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

</thing:thing-descriptions>
